generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String                 @id @default(cuid())
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  identities      AuthIdentity[]
  recipients      Recipient[]
  intents         PaymentIntent[]
  safetyChecks    SafetyCheck[]
  transactions    Transaction[]
  recurringRules  RecurringRule[]
  prompts         ReconciliationPrompt[]
  idempotencyKeys IdempotencyKey[]
  guardians       Guardian[]
  approvalPolicy  ApprovalPolicy?
  approvalRequests ApprovalRequest[]
  budgetPlans      BudgetPlan[]
}

model BudgetPlan {
  id               String   @id @default(cuid())
  userId           String
  recipientName    String
  recipientAddress String
  income           Decimal
  essentials       Decimal
  savings          Decimal
  monthlySupport   Decimal
  remaining        Decimal
  asset            String
  frequency        String
  result           String
  explanation      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Guardian {
  id        String   @id @default(cuid())
  userId    String
  name      String
  address   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  requests  ApprovalRequest[]

  @@unique([userId, address])
  @@index([address])
}

model ApprovalPolicy {
  id                  String   @id @default(cuid())
  userId              String   @unique
  thresholdUsdc       Decimal?
  thresholdSui        Decimal?
  requireNewRecipient Boolean  @default(true)
  requireChangedWallet Boolean @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApprovalRequest {
  id        String   @id @default(cuid())
  userId    String
  guardianId String
  recipient String
  amount    Decimal
  asset     String
  reason    String?
  triggers  String   @default("")
  status    String   @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  guardian  Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)

  @@index([guardianId, status])
  @@index([userId, status])
}

model AuthIdentity {
  id          String   @id @default(cuid())
  provider    String
  providerSub String
  userId      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerSub])
  @@index([userId])
}

model Recipient {
  id             String          @id @default(cuid())
  userId         String
  name           String
  address        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  walletChangedAt DateTime?
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  intents        PaymentIntent[]
  transactions   Transaction[]
  recurringRules RecurringRule[]

  @@unique([userId, name])
  @@index([userId, address])
}

model PaymentIntent {
  id               String        @id @default(cuid())
  userId           String
  recipientId      String?
  instruction      String
  normalizedIntent Json
  status           String
  confirmedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient        Recipient?    @relation(fields: [recipientId], references: [id], onDelete: SetNull)
  safetyChecks     SafetyCheck[]
  transaction      Transaction?

  @@index([userId, createdAt])
}

model SafetyCheck {
  id              String        @id @default(cuid())
  userId          String
  paymentIntentId String
  verdict         String
  flags           Json
  parserResult    Json
  verifierResult  Json
  createdAt       DateTime      @default(now())
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentIntent   PaymentIntent @relation(fields: [paymentIntentId], references: [id], onDelete: Cascade)

  @@index([paymentIntentId])
}

model Transaction {
  id              String         @id @default(cuid())
  userId          String
  paymentIntentId String?        @unique
  recipientId     String?
  // The other party's address: who the money went to on a SENT row, who it
  // came from on a RECEIVED row.
  recipientAddress String?
  amount          Decimal
  asset           String
  status          String
  // Same on-chain digest can now appear twice - once for the sender's SENT
  // row, once for the receiver's mirrored RECEIVED row - so uniqueness moved
  // from digest alone to (userId, digest).
  digest          String?
  direction       String         @default("SENT")
  network         String
  failureReason   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentIntent   PaymentIntent? @relation(fields: [paymentIntentId], references: [id], onDelete: SetNull)
  recipient       Recipient?     @relation(fields: [recipientId], references: [id], onDelete: SetNull)

  @@unique([userId, digest])
  @@index([userId, createdAt])
  @@index([userId, recipientId, createdAt])
}

model RecurringRule {
  id              String                 @id @default(cuid())
  userId          String
  recipientId     String
  amount          Decimal
  asset           String
  frequency       String         @default("MONTHLY")
  monthlyDay      Int
  timezone        String
  nextTriggerAt   DateTime
  status          String
  note            String?
  lastTriggeredAt DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipient       Recipient              @relation(fields: [recipientId], references: [id], onDelete: Restrict)
  prompts         ReconciliationPrompt[]

  @@index([status, nextTriggerAt])
  @@index([userId, nextTriggerAt])
}

model ReconciliationPrompt {
  id              String        @id @default(cuid())
  userId          String
  recurringRuleId String
  matchedAt       DateTime
  windowStart     DateTime
  windowEnd       DateTime
  status          String
  resolution      String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  recurringRule   RecurringRule @relation(fields: [recurringRuleId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model IdempotencyKey {
  id        String   @id @default(cuid())
  userId    String
  key       String
  operation String
  response  Json?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
}
