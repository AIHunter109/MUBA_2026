# Copy to prisma/.env (gitignored). Loaded by the `prisma` CLI AND by the
# `server` script, so this is the single source of truth for the DB connection.
#
# Supabase: DATABASE_URL = transaction-mode pooler (port 6543, ?pgbouncer=true),
# DIRECT_URL = session-mode pooler (port 5432, used for migrations).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"
