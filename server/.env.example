# DATABASE_URL / DIRECT_URL live in prisma/.env (the `server` script loads it).
# On a host (Render, etc.) set them as dashboard env vars instead.
SERVER_PORT=3000
DEMO_MODE=true

SUI_NETWORK=testnet
SUI_RPC_URL=
SUI_USDC_TYPE=

ENOKI_API_KEY=
ENOKI_PROJECT_ID=

# Gonka Router (server-only). Base URL + models have working defaults in config.ts.
GONKA_BASE_URL=https://api.gonkarouter.io
GONKA_API_KEY=
GONKA_PARSER_MODEL=deepseek-ai/DeepSeek-V4-Flash-0731
GONKA_VERIFIER_MODEL=MiniMaxAI/MiniMax-M2.7
GONKA_TIEBREAKER_MODEL=moonshotai/Kimi-K2.6

# HMAC secret for the execution confirmation token. Change for any shared/deployed env.
CONFIRMATION_TOKEN_SECRET=dev-only-change-me

RECONCILIATION_WINDOW_DAYS=14
HIGH_AMOUNT_THRESHOLD_USDC=500

# AI Fact Checker (server/src/factcheck) - retrieves real evidence for claims
# mentioned in a payment message, then has two Gonka models reason over it.
# Free key: https://newsapi.org/register
NEWSAPI_KEY=
# Published `move/fact_check` package id (see move/fact_check/README or the
# project chat history for the publish command) and a DEDICATED service
# keypair's bech32 secret key (never a real user's key) - generate one with:
#   node server/scripts/generate-factcheck-signer.mjs
# Both optional: without them, check-claim still runs, just without the
# on-chain record.
FACTCHECK_PACKAGE_ID=
FACTCHECK_SIGNER_SECRET_KEY=
