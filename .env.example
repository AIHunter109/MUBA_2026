# Template for the Expo client env. Copy to `.env.local` (gitignored) and fill in.
# Only EXPO_PUBLIC_* values are exposed to the app AND bundled into the build -
# never put a private key or secret in this file or in .env.local.
#
# Server-only secrets (database, Gonka, Enoki private key) go in `server/.env`
# - see `server/.env.example`.

# Leave blank for local dev (auto-derives the LAN host for physical devices).
EXPO_PUBLIC_API_URL=

# true = local fixture wallet (no Google); false = real Enoki zkLogin
EXPO_PUBLIC_DEMO_MODE=true

# Enoki Portal -> API Keys -> type: Public, network: Testnet, feature: zkLogin
EXPO_PUBLIC_ENOKI_API_KEY=

# Google Cloud Console -> Credentials -> OAuth client ID -> Web application
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Optional: override the testnet USDC coin type if Phase 0 finds a different one.
# Defaults to Circle native testnet USDC.
EXPO_PUBLIC_USDC_TYPE=
