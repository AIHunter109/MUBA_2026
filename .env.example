# Expo client-safe values only. Never put server secrets in EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_DEMO_MODE=true
EXPO_PUBLIC_ENOKI_API_KEY=
EXPO_PUBLIC_GOOGLE_CLIENT_ID=

# Server values are documented here for local setup. Keep real values in a local ignored env file.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/remitguard
SERVER_PORT=3000
DEMO_MODE=true
SUI_NETWORK=testnet
SUI_RPC_URL=
SUI_USDC_TYPE=
ENOKI_API_KEY=
ENOKI_PROJECT_ID=
GONKA_BASE_URL=
GONKA_API_KEY=
GONKA_PARSER_MODEL=
GONKA_VERIFIER_MODEL=
RECONCILIATION_WINDOW_DAYS=14
HIGH_AMOUNT_THRESHOLD_USDC=500
